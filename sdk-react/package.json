{
  "name": "@zendbx/react",
  "version": "1.0.0",
  "description": "Official React SDK for ZendBX - PostgreSQL Backend-as-a-Service",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "zendbx",
    "react",
    "hooks",
    "baas",
    "postgresql",
    "database",
    "realtime",
    "auth",
    "storage"
  ],
  "author": "ZENDBX <support@zendbx.in>",
  "license": "MIT",
  "homepage": "https://zendbx.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/zendbx/react.git"
  },
  "bugs": {
    "url": "https://github.com/zendbx/react/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@zendbx/sdk": "^1.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
